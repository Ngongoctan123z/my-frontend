{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-frontend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "vndocs.net",
      "zone_name": "vndocs.net",
      "custom_domain": true
    },
    {
      "pattern": "www.vndocs.net",
      "zone_name": "vndocs.net",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exam-web-db",
      "database_id": "a9e9ce4c-ade4-4b5b-986e-88db9e36b60d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SPEAKING_AUDIO",
      "bucket_name": "vndocs-speaking-audio"
    }
  ],
  "build": {
    "command": "node scripts/ensure-speaking-r2.mjs"
  }
}
