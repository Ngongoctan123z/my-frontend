{
  "name": "exam-web-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "pages:build": "opennextjs-cloudflare build",
    "deploy": "opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint .",
    "test:api-rotation": "node --experimental-strip-types tests/ai-key-rotation.test.mjs",
    "test:grader-submissions": "node --experimental-vm-modules tests/grader-submissions.test.mjs",
    "test:build-seo": "node --experimental-vm-modules tests/build-seo.test.mjs && node tests/seo-rendering.test.mjs",
    "test:grader-ui": "node tests/grader-ui.test.mjs",
    "test:speaking": "node --experimental-vm-modules tests/speaking.test.mjs && node --experimental-vm-modules tests/speaking-recorder.test.mjs",
    "test:speaking-ui": "node tests/speaking-ui.test.mjs",
    "prepare:writing-bank": "node scripts/build-writing-bank.mjs",
    "prebuild": "npm run prepare:writing-bank && node scripts/prepare-pdf-worker.mjs",
    "predev": "npm run prepare:writing-bank && node scripts/prepare-pdf-worker.mjs",
    "deploy:preview": "opennextjs-cloudflare upload"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.9.1",
    "@pdfsmaller/pdf-decrypt": "^1.0.1",
    "@pdfsmaller/pdf-encrypt": "^1.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.103.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/sql.js": "^1.4.11",
    "autoprefixer": "^10.6.1",
    "axios": "^1.20.0",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.4.0",
    "docx-preview": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "groq-sdk": "^1.6.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "localforage": "^1.10.0",
    "lucide-react": "^1.52.0",
    "mathjs": "^15.2.0",
    "next": "^15.1.7",
    "next-auth": "^5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-activity-calendar": "^3.2.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.88.0",
    "react-pdf": "^11.0.0",
    "sql.js": "^1.14.2",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^15.1.7",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "wrangler": "^4.140.0"
  }
}
